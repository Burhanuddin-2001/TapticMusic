<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="MusicPlayer.Controls.BadgePill"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Left"
    VerticalAlignment="Center">

    <!-- MinHeight is what makes Radius.Pill legal here: 24 is exactly half of 48, so the two sides
         render flat. Without it the box measured ~35, WinUI clamped each axis on its own, and this
         drew an ellipse — a full circle when the label was one character. MinWidth stops the two
         round ends meeting. The TextBlock centres because a Border child defaults to Stretch and
         would otherwise sit at the top. Step 12. -->
    <Border Background="{x:Bind Fill, Mode=OneWay}"
            BorderBrush="{ThemeResource Brush.Border.Default}"
            BorderThickness="{StaticResource BorderWidth.Standard.Thickness}"
            CornerRadius="{StaticResource Radius.Pill}"
            MinHeight="{StaticResource Size.ControlHeight}"
            MinWidth="{StaticResource Size.Badge.MinWidth}"
            Padding="{StaticResource Space.Badge.Padding}">
        <TextBlock Style="{StaticResource Text.Micro}"
                   Foreground="{x:Bind LabelForeground, Mode=OneWay}"
                   Text="{x:Bind Text, Mode=OneWay}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />
    </Border>
</UserControl>
