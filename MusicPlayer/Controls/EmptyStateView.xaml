<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="MusicPlayer.Controls.EmptyStateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="{StaticResource Space.M}"
                Padding="{StaticResource Space.XL.Thickness}">

        <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}"
                  FontSize="{StaticResource Size.EmptyState.Icon}"
                  Foreground="{ThemeResource Brush.Text.Secondary}"
                  HorizontalAlignment="Center" />

        <TextBlock Style="{StaticResource Text.Heading2}"
                   Text="{x:Bind Title, Mode=OneWay}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center" />

        <TextBlock Style="{StaticResource Text.Caption}"
                   Text="{x:Bind Message, Mode=OneWay}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center" />
    </StackPanel>
</UserControl>
