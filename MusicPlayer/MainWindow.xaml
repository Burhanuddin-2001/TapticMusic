<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MusicPlayer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MusicPlayer.Controls"
    Title="Taptic Music">

    <Grid x:Name="RootGrid"
          Loaded="RootGrid_Loaded"
          Background="{ThemeResource Brush.Background.Canvas}">
        <Grid.Resources>
            <!--
                Step 10c. The page-enter transition.

                Declared here rather than built in code-behind: Motion.Duration.* resolves fine
                through {StaticResource} in XAML, but the SAME key read from C# via
                Application.Current.Resources comes back as a System.Double, and casting it to
                Duration throws InvalidCastException. Found the hard way on 2026-08-19.

                Opacity and a TranslateTransform only — both stay on the compositor at 60fps.

                Targets are assigned per navigation in MainWindow.xaml.cs, because neither the page
                nor its transform exists until the Frame has navigated.
            -->
            <Storyboard x:Key="PageEnter">
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                 From="0"
                                 To="1"
                                 Duration="{StaticResource Motion.Duration.Slow}">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetProperty="Y"
                                 From="{StaticResource Motion.Translate.Page}"
                                 To="0"
                                 Duration="{StaticResource Motion.Duration.Slow}">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Step 10c. Elevated, same as the player bar, so the app is bracketed top and bottom.

             v1.1. The Border is the hard bottom edge. Border.Default is near-black in BOTH themes,
             so the edge stays dark whichever theme is on.

             The caption buttons are ours now, not the system's. MainWindow.xaml.cs collapses the
             system set with TitleBarHeightOption.Collapsed; the system can only recolour its own
             buttons, never give them a border, a shadow or a press. RightHeader is the one slot
             the TitleBar control marks as Passthrough in full, so these three receive the pointer
             while the rest of the bar still drags the window. -->
        <Border Grid.Row="0"
                BorderBrush="{ThemeResource Brush.Border.Default}"
                BorderThickness="{StaticResource BorderWidth.TitleBar.Bottom}">
            <TitleBar x:Name="AppTitleBar"
                      Title="Taptic Music"
                      Background="{ThemeResource Brush.Background.Elevated}">
                <TitleBar.IconSource>
                    <ImageIconSource ImageSource="Assets/AppIcon.ico" />
                </TitleBar.IconSource>

                <TitleBar.RightHeader>
                    <StackPanel Orientation="Horizontal"
                                Spacing="{StaticResource Space.S}"
                                Margin="{StaticResource Space.TitleBar.Caption.Margin}"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource CaptionButtonStyle}"
                                Click="MinimizeButton_Click"
                                ToolTipService.ToolTip="Minimize"
                                AutomationProperties.Name="Minimize">
                            <FontIcon Glyph="&#xEF2D;" FontSize="{StaticResource Size.Glyph.Caption}" />
                        </Button>

                        <!-- Glyph, tooltip and name all flip to Restore while maximized. -->
                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource CaptionButtonStyle}"
                                Click="MaximizeButton_Click"
                                ToolTipService.ToolTip="Maximize"
                                AutomationProperties.Name="Maximize">
                            <FontIcon x:Name="MaximizeGlyph" Glyph="&#xEF2E;" FontSize="{StaticResource Size.Glyph.Caption}" />
                        </Button>

                        <!-- Lightweight styling: these two keys are looked up from inside the
                             template, so overriding them here turns only THIS button red on hover.
                             Text.OnStatus, not Text.Primary: paper ink on Status.Error is 2.78:1. -->
                        <Button Style="{StaticResource CaptionButtonStyle}"
                                Click="CloseButton_Click"
                                ToolTipService.ToolTip="Close"
                                AutomationProperties.Name="Close">
                            <Button.Resources>
                                <StaticResource x:Key="CaptionButtonBackgroundPointerOver" ResourceKey="Brush.Status.Error" />
                                <StaticResource x:Key="CaptionButtonForegroundPointerOver" ResourceKey="Brush.Text.OnStatus" />
                            </Button.Resources>
                            <FontIcon Glyph="&#xEF2C;" FontSize="{StaticResource Size.Glyph.Caption}" />
                        </Button>
                    </StackPanel>
                </TitleBar.RightHeader>
            </TitleBar>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <controls:CustomSidebarRail Grid.Column="0"
                                        SelectionRequested="SidebarRail_SelectionRequested" />

            <Frame x:Name="RootFrame" Grid.Column="1" />

            <!-- Queue rail. Shows the play queue in order; falls back to an empty state. -->
            <Border Grid.Column="2"
                    Width="{StaticResource Size.QueueRail.Width}"
                    Background="{ThemeResource Brush.Background.Elevated}"
                    BorderBrush="{ThemeResource Brush.Border.Default}"
                    BorderThickness="{StaticResource BorderWidth.QueueRail.Left}">
                <Grid>
                    <ListView x:Name="QueueList"
                              SelectionMode="Single"
                              IsItemClickEnabled="True"
                              ItemClick="QueueList_ItemClick"
                              ItemContainerStyle="{StaticResource QueueRowItemStyle}"
                              AutomationProperties.Name="Play queue" />

                    <controls:EmptyStateView x:Name="QueueEmptyState"
                                             Glyph="&#xE8FD;"
                                             Title="Queue is empty"
                                             Message="Tracks you play next show up here." />
                </Grid>
            </Border>
        </Grid>

        <InfoBar x:Name="ErrorBar"
                 Grid.Row="2"
                 Style="{StaticResource InfoBarErrorStyle}"
                 Severity="Error"
                 CloseButtonClick="ErrorBar_CloseButtonClick" />

        <controls:PlayerBarView Grid.Row="3" />
    </Grid>
</Window>
