<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Radius. Sharp is the universal default. Pill is restricted: see design-plan section 10.3. -->
    <CornerRadius x:Key="Radius.Sharp">0</CornerRadius>
    <!-- 24 = half of Size.ControlHeight. A radius larger than half the box makes WinUI clamp
         each axis on its own, which renders an ellipse instead of a flat-sided pill.
         If Size.ControlHeight changes, this must change with it. -->
    <CornerRadius x:Key="Radius.Pill">24</CornerRadius>

    <!-- WinUI system radius keys. Names are fixed by WinUI. Setting both to 0 squares off every
         default template we have not retemplated ourselves, including the ScrollBar thumb. -->
    <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>

    <!-- Border widths. -->
    <x:Double x:Key="BorderWidth.Standard">2</x:Double>
    <Thickness x:Key="BorderWidth.Standard.Thickness">2</Thickness>
    <Thickness x:Key="BorderWidth.PlayerBar.Top">0,3,0,0</Thickness>
    <Thickness x:Key="BorderWidth.QueueRail.Left">2,0,0,0</Thickness>
    <!-- v1.1. 2, not the player bar's 3: the two rails meet this edge from below at 2, and equal
         weights make a clean T instead of a step. -->
    <Thickness x:Key="BorderWidth.TitleBar.Bottom">0,0,0,2</Thickness>
    <Thickness x:Key="BorderWidth.SidebarRail.Right">0,0,2,0</Thickness>
    <!-- Bottom edge only. Gate 0 chose row separators over a full cell grid, so a track row spends
         its 2px on one edge and never on vertical dividers. -->
    <Thickness x:Key="BorderWidth.TrackRow.Bottom">0,0,0,2</Thickness>

    <!-- Hard offset shadow, Step 10c. Solid colour, offset, ZERO blur — never a ThemeShadow.

         2 is not arbitrary: it is the same 2 the Pressed VisualStates translate by, so pressing
         drops a control exactly onto its own shadow and closes the gap. The two must stay equal,
         so both now read this one key. Do not split them again.

         The Thickness is the shadow layer's Margin. Positive left/top pushes it down-right;
         negative right/bottom lets it keep the same size instead of shrinking. Net effect: an
         offset copy that costs the layout nothing. -->
    <x:Double x:Key="Shadow.Offset">2</x:Double>
    <Thickness x:Key="Shadow.Offset.Thickness">2,2,-2,-2</Thickness>

    <!-- Dimensions from design-plan section 2 Metrics and section 5 Layout. -->
    <x:Double x:Key="Size.IconButton">32</x:Double>
    <!-- Floor, not a fixed size. Space.L padding plus a 13px label lands a real button at ~49.
         48 keeps the 8px grid and matches Size.TrackRow.MinHeight. Always apply as MinHeight. -->
    <x:Double x:Key="Size.ControlHeight">48</x:Double>
    <!-- Badge pill, Step 12. Must exceed the 48 MinHeight: at exactly 48 the two 24px round ends
         meet in the middle and a one-character badge renders as a circle. 72 leaves 24 of flat
         side, so the shape reads as a pill no matter how short the label is.
         x:Double, not GridLength: it targets FrameworkElement.MinWidth. See A13. -->
    <x:Double x:Key="Size.Badge.MinWidth">72</x:Double>
    <!-- Step 11. Was 60, widened so a rail item has room to cast its shadow.
         70 = the 2px right border, plus 4 of gap, plus the 60 item, plus 4 of gap. Change any of
         those and this moves with them, or the items stop being square. -->
    <x:Double x:Key="Size.SidebarRail.Width">70</x:Double>
    <x:Double x:Key="Size.SidebarRail.Item">60</x:Double>
    <!-- Horizontal only: a vertical gap would break the rail into floating tiles. The shadow
         falls 2px right, so 4 is enough for it to land in. -->
    <Thickness x:Key="Size.SidebarRail.Item.Gap">4,0,4,0</Thickness>
    <x:Double x:Key="Size.PlayerBar.Height">92</x:Double>
    <!-- v1.1. The title row of every tab. Every tab's row is exactly this tall at every text size,
         so a title never moves when you switch tabs, and the count pills centre on it.

         It holds because nothing in the row can outgrow it:
         - The title takes TextLineBounds Tight, so its box is cap height only: about 39 at 250%.
           Tight is also what makes centring optical. A full line box includes the descender, and
           its centre sat 4.5px below the capitals at 250%, so the pill looked low.
         - The pill and the Playlists button take Space.PageHeader.Overhang, so they may spill a
           few pixels into the page padding and the row gap instead of stretching the row.
         Applied as RowDefinition.MinHeight, with the title VerticalAlignment Center in the row. -->
    <x:Double x:Key="Size.PageHeader.MinHeight">48</x:Double>
    <x:Double x:Key="Size.QueueRail.Width">300</x:Double>
    <!-- v1.3: 916, was 900. This is the window's OUTER width, and Windows' resize borders take
         about 13 of it. That slack was covered by accident until the fader took 22 of the page:
         at 900 the Dashboard dropped to one tile per row. See Size.Tile. -->
    <x:Double x:Key="Size.Window.MinWidth">916</x:Double>
    <x:Double x:Key="Size.Window.MinHeight">600</x:Double>

    <!-- Text-scaling safety: rows use MinHeight, never Height. design-plan section 7.1. -->
    <x:Double x:Key="Size.TrackRow.MinHeight">48</x:Double>
    <!-- Fixed so the number cell's four contents — ordinal, play glyph, level bars (Step 10c) and
         hazard stripes — never change the row's column layout between them. Widths chosen at
         Gate 0, 2026-08-18.
         GridLength, not x:Double: both keys are consumed ONLY as ColumnDefinition.Width, which is
         a GridLength. A StaticResource bypasses the XAML string converter, so a boxed Double goes
         straight into a GridLength setter — it compiles clean and fails later, inside the measure
         pass, as COMException 0x80004005. That was LIB-001. -->
    <GridLength x:Key="Size.TrackRow.NumberCell">44</GridLength>
    <GridLength x:Key="Size.TrackRow.TimeCell">60</GridLength>
    <!-- Vertical gap between rows, Step 10c. Rows sat flush against each other, which left the
         hover/selected shadow nowhere to land — it was invisible. Bottom edge ONLY: any left or
         right margin here would shift the cells out from under the header and break the column
         alignment that A12 exists to protect. -->
    <Thickness x:Key="Size.TrackRow.Gap">0,0,0,4</Thickness>
    <x:Double x:Key="Size.PlayerBar.ArtThumb">64</x:Double>
    <x:Double x:Key="Size.EmptyState.Icon">48</x:Double>

    <!-- Square cover tile, Step 14. Shared by the Playlists index and the Dashboard deal.

         220 is measured against the narrowest the app can get, not chosen by eye.
         Size.Window.MinWidth is 916, about 903 inside the resize borders; less the 70 sidebar rail
         and the queue rail's 300 plus its 2px border, that leaves a 531 frame; less 48 of
         Space.Page.Padding and, once the page scrolls, the 22 of Size.Fader.Width, 461. An
         ItemsWrapGrid cell is this width PLUS the gap below, so two cells cost
         456 and fit, and three cost 684 and do not. That is why both hosts wrap instead of using a
         fixed-column Grid: at the minimum size the row holds two, and it holds four on a normal
         window. Widening this key past 222 silently drops the minimum window to one tile per row.

         Height is deliberately NOT a token. The art row is exactly this square and the text band
         below it sizes to its own content, so the tile grows with Windows text scaling instead of
         clipping — the same reason every row in this file uses MinHeight and never Height.

         x:Double and not GridLength: both are consumed as FrameworkElement Width and Height.
         Feeding either to a ColumnDefinition.Width would be LIB-001 all over again. See A13. -->
    <x:Double x:Key="Size.Tile">220</x:Double>
    <!-- Right and bottom only, so the grid stays flush with the page padding on the left and top
         edges and the gap is never paid twice between two tiles. Must exceed Shadow.Offset, or the
         next tile sits on this one's shadow and the 2px press drop reads as jitter rather than
         depth - same reason as Size.TrackRow.Gap. 8 and not 16 because the cell is Size.Tile plus
         this, and 16 would push two cells to 472 and break the two-up row at the minimum window. -->
    <Thickness x:Key="Size.Tile.Gap">0,0,8,8</Thickness>

    <!-- FontIcon sizes. Glyphs are not text, so they get their own keys rather than borrowing a
         Text.* style: a FontIcon takes a bare FontSize and cannot take a TextBlock Style.
         Added in Step 10a to retire 11 raw literals across Controls/ and Styles/. -->
    <x:Double x:Key="Size.Glyph.Small">14</x:Double>
    <x:Double x:Key="Size.Glyph.Medium">18</x:Double>
    <x:Double x:Key="Size.Glyph.Large">24</x:Double>
    <!-- v1.1. The Chrome*Contrast glyphs are drawn for a 10px box; 12 keeps their heavier stroke
         inside a 32 caption button without crowding the 2px border. -->
    <x:Double x:Key="Size.Glyph.Caption">12</x:Double>

    <!-- v1.1. WinUI-owned key, flat entry, same merge-order win as ControlCornerRadius above. The
         TitleBar control switches to this height as soon as it has a RightHeader, and WinUI's 48
         would grow the bar by 16px for three 32px buttons. 40 = 32, plus the 2px shadow, plus 3
         above and 3 below. -->
    <x:Double x:Key="TitleBarExpandedHeight">40</x:Double>
    <!-- v1.1. WinUI keeps a 48px drag strip between RightHeader and the system buttons. With the
         system buttons gone it sat to the RIGHT of close, so close no longer met the window edge.
         The whole bar left of the buttons still drags. -->
    <x:Double x:Key="TitleBarMinDragRegionWidth">0</x:Double>

    <!-- Keyboard focus ring offset, applied per control in Step 04. design-plan section 4 state matrix. -->
    <Thickness x:Key="Focus.Visual.Margin">-4</Thickness>


    <!-- Seek bar. design-plan section 4.1. Block COUNT is fixed at 30 in the template; block width is proportional. -->
    <x:Double x:Key="Size.SeekBar.Height">16</x:Double>
    <x:Double x:Key="Size.SeekBar.Block.Gap">2</x:Double>
    <x:Double x:Key="Size.SeekBar.Thumb.Width">14</x:Double>
    <x:Double x:Key="Size.SeekBar.Thumb.Height">28</x:Double>

    <!-- Two-step switch. Square thumb, never round. design-plan section 4.5. -->
    <x:Double x:Key="Size.Switch.Track.Width">80</x:Double>
    <x:Double x:Key="Size.Switch.Track.Height">32</x:Double>
    <x:Double x:Key="Size.Switch.Thumb.Width">18</x:Double>
    <x:Double x:Key="Size.Switch.Thumb.Height">24</x:Double>
    <!-- Thickness, not a scalar twin: consumed directly by the thumb's Margin. Left and right are
         both 11; only the component on the aligned side ever takes effect. -->
    <Thickness x:Key="Size.Switch.Thumb.Inset">11,0,11,0</Thickness>
    <!-- How far the thumb slides, Step 11. HorizontalAlignment is not animatable, so the checked
         states used to flip it to Right and the thumb teleported. It now rides a TranslateTransform.
         36 = Track.Width 80, minus the 2px border on each side, minus Thumb.Width 18, minus both
         Inset components: 80 - 4 - 18 - 22. If any of those four keys move, this one moves with them.
         x:Double, not Thickness: it is read by DoubleAnimation.To, the same as Shadow.Offset. -->
    <x:Double x:Key="Size.Switch.Thumb.Travel">36</x:Double>

    <!-- Text-size dial, v1.1. One tick per percent, so Tick.Spacing is also how far a drag must
         travel for 1%: 8 makes 1% a deliberate move without making the 80-250 range a long haul.
         Needle.Height is also where the labels start, so the needle never covers a number.
         72 = the 2px border twice, plus 26 of needle, plus room for a label at 250%. -->
    <x:Double x:Key="Size.Dial.Height">72</x:Double>
    <x:Double x:Key="Size.Dial.Tick.Spacing">8</x:Double>
    <x:Double x:Key="Size.Dial.Tick.Width">2</x:Double>
    <x:Double x:Key="Size.Dial.Tick.Minor">8</x:Double>
    <x:Double x:Key="Size.Dial.Tick.Middle">14</x:Double>
    <x:Double x:Key="Size.Dial.Tick.Major">22</x:Double>
    <x:Double x:Key="Size.Dial.Needle.Width">8</x:Double>
    <x:Double x:Key="Size.Dial.Needle.Height">26</x:Double>
    <!-- Fixed, so a label that grows with the text stays centred on its tick. 56 fits "250" at 250%. -->
    <x:Double x:Key="Size.Dial.Label.Width">56</x:Double>

    <!-- Volume slider. Solid fill, not segmented. -->
    <x:Double x:Key="Size.VolumeBar.Width">110</x:Double>
    <x:Double x:Key="Size.VolumeBar.Height">10</x:Double>
    <x:Double x:Key="Size.VolumeBar.Thumb.Width">12</x:Double>
    <x:Double x:Key="Size.VolumeBar.Thumb.Height">20</x:Double>

    <!-- Channel Fader, v1.3: every scroll bar in the app. Styles/ScrollBar.xaml.

         The width is also the column every ScrollViewer now keeps for its bar, so it is a layout
         number and not only a look. It must stay at 27 or under: at Size.Window.MinWidth a page is
         about 483 wide inside its padding, and two Size.Tile cells need 456 of that.
         Inside the 22: ticks from 1 to 7, the slot from 9 to 13, the cap from 3 to 19 and its
         shadow to 21. Move one of these and the others move with it. -->
    <x:Double x:Key="Size.Fader.Width">22</x:Double>
    <!-- For a header that sits outside its list and must stop where the rows stop. -->
    <Thickness x:Key="Size.Fader.Gutter">0,0,22,0</Thickness>
    <x:Double x:Key="Size.Fader.Slot.Width">4</x:Double>
    <!-- Slot and scale end 6 in from the top and 8 from the bottom, so neither shows past a cap
         parked at either end: 6 is inside the cap, 8 also clears its 2px shadow. -->
    <Thickness x:Key="Size.Fader.Slot.Margin">9,6,0,8</Thickness>
    <Thickness x:Key="Size.Fader.Scale.Margin">1,6,0,8</Thickness>
    <x:Double x:Key="Size.Fader.Tick.Minor">4</x:Double>
    <x:Double x:Key="Size.Fader.Tick.Major">6</x:Double>
    <x:Double x:Key="Size.Fader.Cap.Width">16</x:Double>
    <Thickness x:Key="Size.Fader.Cap.Margin">3,0,0,0</Thickness>
    <!-- The smallest the cap gets, which is the size it has on any long list. WinUI's own floor is
         30; 40 keeps the cap a thing you can grab. -->
    <x:Double x:Key="Size.Fader.Cap.MinLength">40</x:Double>
    <x:Double x:Key="Size.Fader.Grip.Width">10</x:Double>
    <x:Double x:Key="Size.Fader.Now">10</x:Double>
    <x:Double x:Key="Size.Fader.Strip.MaxWidth">240</x:Double>
    <!-- Horizontal twins of the slot and cap margins. No list in the app scrolls sideways; WinUI's
         ScrollBar still has to be able to. -->
    <Thickness x:Key="Size.Fader.Slot.Margin.Horizontal">6,9,8,0</Thickness>
    <Thickness x:Key="Size.Fader.Cap.Margin.Horizontal">0,3,0,0</Thickness>

</ResourceDictionary>
