<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Two-step switch built on ToggleButton, which has no required template-part contract, so a
         click always reaches IsChecked regardless of the template. design-plan section 4.5, O-8. -->
    <Style x:Key="TwoStepSwitchStyle" TargetType="ToggleButton">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualMargin" Value="{StaticResource Focus.Visual.Margin}" />
        <!-- Step 16. A mouse click must not park the keyboard. Trap: see TRAPS.md T-10. -->
        <Setter Property="AllowFocusOnInteraction" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="RootGrid" Background="Transparent">
                        <!-- UIElement.Translation throws from a VisualState Setter; RenderTransform
                             with a named TranslateTransform is the approved fallback (D-2). -->
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="PressTransform" />
                        </Grid.RenderTransform>

                        <!-- VisualStateManager reads state groups off the template ROOT only. A plain
                             ToggleButton fires one combined state per interaction inside a single
                             CommonStates group (Checked, CheckedPressed, CheckedDisabled, ...),
                             verified against this SDK's generic.xaml. There is no separate check-state
                             group and no distinct unchecked-state name here; Normal already covers
                             unchecked-and-idle. CheckedPointerOver is left undefined on purpose: the
                             fill already covers the whole track when checked, so hover has nothing new
                             to show, and an unmatched state name just leaves the prior one in place. -->
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <!-- Step 10c. Press geometry animates over Motion.Duration.Fast. Normal, PointerOver and
                                     Checked each reset it, because all three are reachable from a pressed state and a
                                     state that does not animate it back lets the release snap. -->
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="0"
                                                         Duration="{StaticResource Motion.Duration.Fast}" />
                                        <DoubleAnimation Storyboard.TargetName="PressTransform"
                                                         Storyboard.TargetProperty="Y"
                                                         To="0"
                                                         Duration="{StaticResource Motion.Duration.Fast}" />
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="0"
                                                         Duration="{StaticResource Motion.Duration.Standard}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Track.Background" Value="{ThemeResource Brush.Surface.Hover}" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="0"
                                                         Duration="{StaticResource Motion.Duration.Fast}" />
                                        <DoubleAnimation Storyboard.TargetName="PressTransform"
                                                         Storyboard.TargetProperty="Y"
                                                         To="0"
                                                         Duration="{StaticResource Motion.Duration.Fast}" />
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="0"
                                                         Duration="{StaticResource Motion.Duration.Standard}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="{StaticResource Shadow.Offset}"
                                                         Duration="{StaticResource Motion.Duration.Fast}" />
                                        <DoubleAnimation Storyboard.TargetName="PressTransform"
                                                         Storyboard.TargetProperty="Y"
                                                         To="{StaticResource Shadow.Offset}"
                                                         Duration="{StaticResource Motion.Duration.Fast}" />
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="0"
                                                         Duration="{StaticResource Motion.Duration.Standard}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="0"
                                                         Duration="{StaticResource Motion.Duration.Standard}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Fill.Visibility" Value="Visible" />
                                        <Setter Target="Label.Text" Value="ON" />
                                        <Setter Target="Label.Foreground" Value="{ThemeResource Brush.Text.OnAccent}" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="0"
                                                         Duration="{StaticResource Motion.Duration.Fast}" />
                                        <DoubleAnimation Storyboard.TargetName="PressTransform"
                                                         Storyboard.TargetProperty="Y"
                                                         To="0"
                                                         Duration="{StaticResource Motion.Duration.Fast}" />
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="{StaticResource Size.Switch.Thumb.Travel}"
                                                         Duration="{StaticResource Motion.Duration.Standard}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Fill.Visibility" Value="Visible" />
                                        <Setter Target="Label.Text" Value="ON" />
                                        <Setter Target="Label.Foreground" Value="{ThemeResource Brush.Text.OnAccent}" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="{StaticResource Shadow.Offset}"
                                                         Duration="{StaticResource Motion.Duration.Fast}" />
                                        <DoubleAnimation Storyboard.TargetName="PressTransform"
                                                         Storyboard.TargetProperty="Y"
                                                         To="{StaticResource Shadow.Offset}"
                                                         Duration="{StaticResource Motion.Duration.Fast}" />
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="{StaticResource Size.Switch.Thumb.Travel}"
                                                         Duration="{StaticResource Motion.Duration.Standard}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.4" />
                                        <Setter Target="Fill.Visibility" Value="Visible" />
                                        <Setter Target="Label.Text" Value="ON" />
                                        <Setter Target="Label.Foreground" Value="{ThemeResource Brush.Text.OnAccent}" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="{StaticResource Size.Switch.Thumb.Travel}"
                                                         Duration="{StaticResource Motion.Duration.Standard}">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border x:Name="Track"
                                Width="{StaticResource Size.Switch.Track.Width}"
                                Height="{StaticResource Size.Switch.Track.Height}"
                                Background="{ThemeResource Brush.Background.Surface}"
                                BorderBrush="{ThemeResource Brush.Border.Default}"
                                BorderThickness="{StaticResource BorderWidth.Standard.Thickness}"
                                CornerRadius="{StaticResource Radius.Sharp}">
                            <Grid>
                                <!-- Off = collapsed, not zero-width: avoids animating or measuring a
                                     Width in a template that must not animate anything (Step 10 only). -->
                                <Rectangle x:Name="Fill"
                                           Fill="{ThemeResource Brush.Accent.Primary}"
                                           Visibility="Collapsed" />
                                <!-- v1.1. Text.Micro's face at a FIXED size, not the style itself.
                                     The track, thumb and travel are fixed geometry, so a label that
                                     followed the text-size dial ran into the thumb at 250%. The
                                     label is part of the control, like its glyph, not reading text. -->
                                <TextBlock x:Name="Label"
                                           Text="OFF"
                                           FontFamily="{StaticResource Font.Display}"
                                           FontSize="{StaticResource FontSize.Micro}"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource Brush.Text.Secondary}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Border Width="{StaticResource Size.Switch.Thumb.Width}"
                                        Height="{StaticResource Size.Switch.Thumb.Height}"
                                        Margin="{StaticResource Size.Switch.Thumb.Inset}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{ThemeResource Brush.Accent.Primary}"
                                        BorderBrush="{ThemeResource Brush.Border.Default}"
                                        BorderThickness="{StaticResource BorderWidth.Standard.Thickness}"
                                        CornerRadius="{StaticResource Radius.Sharp}">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="ThumbTransform" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
