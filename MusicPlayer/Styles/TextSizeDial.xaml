<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MusicPlayer.Controls">

    <!--
        v1.1. The text-size dial. Implicit, because there is one and it has no other look.

        Same two layers as PanelStyle and every button: a hard shadow slab, then the bordered face.
        The tape and its ticks are built in Controls/TextSizeDial.cs. The needle is drawn here, after
        the tape, so it always sits on top of it.

        PART_Viewport is the clip box. It has a Transparent background on purpose: without one, only
        the ticks themselves would take a press, and the gaps between them would not.
    -->
    <Style TargetType="controls:TextSizeDial">
        <Setter Property="Background" Value="{ThemeResource Brush.Background.Elevated}" />
        <Setter Property="BorderBrush" Value="{ThemeResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderWidth.Standard.Thickness}" />
        <Setter Property="Height" Value="{StaticResource Size.Dial.Height}" />
        <Setter Property="SmallChange" Value="1" />
        <Setter Property="LargeChange" Value="10" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="{StaticResource Focus.Visual.Margin}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:TextSizeDial">
                    <Grid>
                        <Border Background="{ThemeResource Brush.Shadow}"
                                Margin="{StaticResource Shadow.Offset.Thickness}" />

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid x:Name="PART_Viewport" Background="Transparent">
                                <Canvas x:Name="PART_Tape">
                                    <Canvas.RenderTransform>
                                        <TranslateTransform x:Name="PART_TapeTransform" />
                                    </Canvas.RenderTransform>
                                </Canvas>

                                <!-- Hangs from the top edge, down to where the labels start, so the
                                     number under it stays readable. -->
                                <Rectangle Width="{StaticResource Size.Dial.Needle.Width}"
                                           Height="{StaticResource Size.Dial.Needle.Height}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Top"
                                           Fill="{ThemeResource Brush.Accent.Primary}"
                                           Stroke="{ThemeResource Brush.Border.Default}"
                                           StrokeThickness="{StaticResource BorderWidth.Standard}" />
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
