<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:MusicPlayer.Services">

    <Style TargetType="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{ThemeResource Brush.Background.Elevated}" />
        <Setter Property="BorderBrush" Value="{ThemeResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderWidth.Standard.Thickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sharp}" />
        <Setter Property="Shadow" Value="{x:Null}" />
    </Style>

    <!--
        Step 13 Part B. Both of these had NO app style at all, so they rendered from WinUI's own
        theme keys — a Fluent divider and a Fluent submenu inside an otherwise retemplated menu.
        ThemeService mutates the app's brushes, not WinUI's, so ownership is the only way they follow
        the theme.

        MenuFlyoutSubItem is deliberately NOT retemplated: its default template pulls in a ~20-key
        family, and the one call site in the app ("Add to playlist" in LibraryPage) needs the fill
        and the ink, not bespoke chevron states. If its hover ever reads wrong, that is the reason.
    -->
    <Style TargetType="MenuFlyoutSeparator">
        <Setter Property="Background" Value="{ThemeResource Brush.Border.Default}" />
        <Setter Property="Height" Value="{StaticResource BorderWidth.Standard}" />
        <Setter Property="Margin" Value="{StaticResource Space.XS.Thickness}" />
    </Style>

    <Style TargetType="MenuFlyoutSubItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="services:TextScale.BaseSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Padding" Value="{StaticResource Space.M.Thickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sharp}" />
    </Style>

    <Style TargetType="MenuFlyoutItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource Brush.Text.Primary}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sharp}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuFlyoutItem">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{StaticResource Space.M.Thickness}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource Brush.Surface.Hover}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <TextBlock Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
