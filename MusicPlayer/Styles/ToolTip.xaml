<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{ThemeResource Brush.Background.Elevated}" />
        <Setter Property="BorderBrush" Value="{ThemeResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderWidth.Standard.Thickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sharp}" />
        <Setter Property="Foreground" Value="{ThemeResource Brush.Text.Secondary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
        <Setter Property="Padding" Value="{StaticResource Space.S.Thickness}" />
        <Setter Property="Shadow" Value="{x:Null}" />
    </Style>

</ResourceDictionary>
