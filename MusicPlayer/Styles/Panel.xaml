<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Step 10c. Retargeted from Border to ContentControl to carry a hard offset shadow.

        A Style on a Border cannot add one. The shadow has to be a SIBLING drawn behind the panel,
        and a Style can only set properties on the element it is applied to. A templated
        ContentControl owns its own visual tree, so the shadow is declared once here instead of
        being pasted into three pages as hand-written scaffolding.

        Call sites therefore changed from <Border Style="{StaticResource PanelStyle}"> to
        <ContentControl Style="{StaticResource PanelStyle}"> — DashboardPage and SettingsPage x2.

        HorizontalContentAlignment and VerticalContentAlignment MUST be Stretch. ContentControl
        defaults them to Left and Top, unlike Border, which would shrink every panel to its
        content and break the 4-up stat strip on the Dashboard.
    -->
    <Style x:Key="PanelStyle" TargetType="ContentControl">
        <Setter Property="Background" Value="{ThemeResource Brush.Background.Surface}" />
        <Setter Property="BorderBrush" Value="{ThemeResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderWidth.Standard.Thickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sharp}" />
        <Setter Property="Padding" Value="{StaticResource Space.L.Thickness}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <!-- Drawn first, so it sits behind. The negative right/bottom margin offsets
                             the slab without changing what the Grid measures. -->
                        <Border Background="{ThemeResource Brush.Shadow}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Margin="{StaticResource Shadow.Offset.Thickness}" />

                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
