<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Both templates keep WinUI's required part names and layout skeleton:
        SliderContainer > HorizontalTemplate (3 columns Auto/Auto/*, 3 rows), holding
        HorizontalTrackRect, HorizontalDecreaseRect and HorizontalThumb.
        The Slider's own code sizes column 0 and column 1 to move the thumb. Removing
        HorizontalTemplate leaves the thumb frozen, which is what the first build did.
    -->

    <!-- Thumb chrome, shared. Shape comes from the CornerRadius set by each caller. -->
    <Style x:Key="SliderThumbBaseStyle" TargetType="Thumb">
        <Setter Property="Background" Value="{ThemeResource Brush.Accent.Primary}" />
        <Setter Property="BorderBrush" Value="{ThemeResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderWidth.Standard.Thickness}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <!--
                        Step 10c. Slider.xaml had no VisualStateManager at all, so the Thumb's own
                        GoToState calls landed nowhere and neither slider gave any press feedback.
                        One VSM here covers both thumbs, because both sliders share this style.

                        The Grid is the template ROOT, so the state groups belong on it, not on Root.
                    -->
                    <Grid x:Name="Layout">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="0"
                                                         Duration="{StaticResource Motion.Duration.Fast}" />
                                        <DoubleAnimation Storyboard.TargetName="PressTransform"
                                                         Storyboard.TargetProperty="Y"
                                                         To="0"
                                                         Duration="{StaticResource Motion.Duration.Fast}" />
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource Brush.Accent.Primary}" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="0"
                                                         Duration="{StaticResource Motion.Duration.Fast}" />
                                        <DoubleAnimation Storyboard.TargetName="PressTransform"
                                                         Storyboard.TargetProperty="Y"
                                                         To="0"
                                                         Duration="{StaticResource Motion.Duration.Fast}" />
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource Brush.Accent.PrimaryPressed}" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="{StaticResource Shadow.Offset}"
                                                         Duration="{StaticResource Motion.Duration.Fast}" />
                                        <DoubleAnimation Storyboard.TargetName="PressTransform"
                                                         Storyboard.TargetProperty="Y"
                                                         To="{StaticResource Shadow.Offset}"
                                                         Duration="{StaticResource Motion.Duration.Fast}" />
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Layout.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border Background="{ThemeResource Brush.Shadow}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Margin="{StaticResource Shadow.Offset.Thickness}" />

                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="PressTransform" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         VOLUME — implicit Slider. Solid fill. No blocks. Square thumb.
         ============================================================ -->
    <Style TargetType="Slider">
        <Setter Property="IsThumbToolTipEnabled" Value="False" />
        <Setter Property="FocusVisualMargin" Value="{StaticResource Focus.Visual.Margin}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="SliderContainer" Background="Transparent">
                        <Grid x:Name="HorizontalTemplate" MinHeight="{StaticResource Size.VolumeBar.Thumb.Height}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Rectangle x:Name="HorizontalTrackRect"
                                       Grid.Row="1" Grid.ColumnSpan="3"
                                       Height="{StaticResource Size.VolumeBar.Height}"
                                       Fill="{ThemeResource Brush.Background.Surface}" />

                            <Rectangle x:Name="HorizontalDecreaseRect"
                                       Grid.Row="1"
                                       Height="{StaticResource Size.VolumeBar.Height}"
                                       Fill="{ThemeResource Brush.Accent.Primary}" />

                            <!-- Frame drawn last so it sits above both fills. -->
                            <Border Grid.Row="1" Grid.ColumnSpan="3"
                                    Height="{StaticResource Size.VolumeBar.Height}"
                                    BorderBrush="{ThemeResource Brush.Border.Default}"
                                    BorderThickness="{StaticResource BorderWidth.Standard.Thickness}"
                                    CornerRadius="{StaticResource Radius.Sharp}"
                                    IsHitTestVisible="False" />

                            <Thumb x:Name="HorizontalThumb"
                                   Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                                   Style="{StaticResource SliderThumbBaseStyle}"
                                   Width="{StaticResource Size.VolumeBar.Thumb.Width}"
                                   Height="{StaticResource Size.VolumeBar.Thumb.Height}"
                                   CornerRadius="{StaticResource Radius.Sharp}"
                                   AutomationProperties.AccessibilityView="Raw" />
                        </Grid>

                        <!-- Required part. This app never uses a vertical slider. -->
                        <Grid x:Name="VerticalTemplate" Visibility="Collapsed" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         SEEK — 30 blocks. design-plan section 4.1.

         Contract: this style assumes Minimum 0 and Maximum 100, so Value is a
         percentage. StepFrequency 100/30 with SnapsTo StepValues makes the pink
         fill land on a block edge, so blocks read as lit or unlit, never half.
         Bind playback position as a percentage of track duration.

         The gap overlay draws only the 29 dividers, as 2px bars pinned to the right
         edge of columns 0-28. It does NOT paint a black background behind transparent
         cells — that would black out the whole track.
         ============================================================ -->
    <Style x:Key="SeekBarSliderStyle" TargetType="Slider">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="StepFrequency" Value="3.3333333" />
        <Setter Property="SnapsTo" Value="StepValues" />
        <Setter Property="IsThumbToolTipEnabled" Value="False" />
        <Setter Property="FocusVisualMargin" Value="{StaticResource Focus.Visual.Margin}" />
        <Setter Property="AutomationProperties.Name" Value="Seek position" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="SliderContainer" Background="Transparent">
                        <Grid x:Name="HorizontalTemplate" MinHeight="{StaticResource Size.SeekBar.Thumb.Height}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Rectangle x:Name="HorizontalTrackRect"
                                       Grid.Row="1" Grid.ColumnSpan="3"
                                       Height="{StaticResource Size.SeekBar.Height}"
                                       Fill="{ThemeResource Brush.Background.Surface}" />

                            <Rectangle x:Name="HorizontalDecreaseRect"
                                       Grid.Row="1"
                                       Height="{StaticResource Size.SeekBar.Height}"
                                       Fill="{ThemeResource Brush.Accent.Primary}" />

                            <Grid Grid.Row="1" Grid.ColumnSpan="3"
                                  Height="{StaticResource Size.SeekBar.Height}"
                                  Background="Transparent"
                                  IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Rectangle Grid.Column="0"  Width="{StaticResource Size.SeekBar.Block.Gap}" HorizontalAlignment="Right" Fill="{ThemeResource Brush.Border.Default}" />
                                <Rectangle Grid.Column="1"  Width="{StaticResource Size.SeekBar.Block.Gap}" HorizontalAlignment="Right" Fill="{ThemeResource Brush.Border.Default}" />
                                <Rectangle Grid.Column="2"  Width="{StaticResource Size.SeekBar.Block.Gap}" HorizontalAlignment="Right" Fill="{ThemeResource Brush.Border.Default}" />
                                <Rectangle Grid.Column="3"  Width="{StaticResource Size.SeekBar.Block.Gap}" HorizontalAlignment="Right" Fill="{ThemeResource Brush.Border.Default}" />
                                <Rectangle Grid.Column="4"  Width="{StaticResource Size.SeekBar.Block.Gap}" HorizontalAlignment="Right" Fill="{ThemeResource Brush.Border.Default}" />
                                <Rectangle Grid.Column="5"  Width="{StaticResource Size.SeekBar.Block.Gap}" HorizontalAlignment="Right" Fill="{ThemeResource Brush.Border.Default}" />
                                <Rectangle Grid.Column="6"  Width="{StaticResource Size.SeekBar.Block.Gap}" HorizontalAlignment="Right" Fill="{ThemeResource Brush.Border.Default}" />
                                <Rectangle Grid.Column="7"  Width="{StaticResource Size.SeekBar.Block.Gap}" HorizontalAlignment="Right" Fill="{ThemeResource Brush.Border.Default}" />
                                <Rectangle Grid.Column="8"  Width="{StaticResource Size.SeekBar.Block.Gap}" HorizontalAlignment="Right" Fill="{ThemeResource Brush.Border.Default}" />
                                <Rectangle Grid.Column="9"  Width="{StaticResource Size.SeekBar.Block.Gap}" HorizontalAlignment="Right" Fill="{ThemeResource Brush.Border.Default}" />
                                <Rectangle Grid.Column="10" Width="{StaticResource Size.SeekBar.Block.Gap}" HorizontalAlignment="Right" Fill="{ThemeResource Brush.Border.Default}" />
                                <Rectangle Grid.Column="11" Width="{StaticResource Size.SeekBar.Block.Gap}" HorizontalAlignment="Right" Fill="{ThemeResource Brush.Border.Default}" />
                                <Rectangle Grid.Column="12" Width="{StaticResource Size.SeekBar.Block.Gap}" HorizontalAlignment="Right" Fill="{ThemeResource Brush.Border.Default}" />
                                <Rectangle Grid.Column="13" Width="{StaticResource Size.SeekBar.Block.Gap}" HorizontalAlignment="Right" Fill="{ThemeResource Brush.Border.Default}" />
                                <Rectangle Grid.Column="14" Width="{StaticResource Size.SeekBar.Block.Gap}" HorizontalAlignment="Right" Fill="{ThemeResource Brush.Border.Default}" />
                                <Rectangle Grid.Column="15" Width="{StaticResource Size.SeekBar.Block.Gap}" HorizontalAlignment="Right" Fill="{ThemeResource Brush.Border.Default}" />
                                <Rectangle Grid.Column="16" Width="{StaticResource Size.SeekBar.Block.Gap}" HorizontalAlignment="Right" Fill="{ThemeResource Brush.Border.Default}" />
                                <Rectangle Grid.Column="17" Width="{StaticResource Size.SeekBar.Block.Gap}" HorizontalAlignment="Right" Fill="{ThemeResource Brush.Border.Default}" />
                                <Rectangle Grid.Column="18" Width="{StaticResource Size.SeekBar.Block.Gap}" HorizontalAlignment="Right" Fill="{ThemeResource Brush.Border.Default}" />
                                <Rectangle Grid.Column="19" Width="{StaticResource Size.SeekBar.Block.Gap}" HorizontalAlignment="Right" Fill="{ThemeResource Brush.Border.Default}" />
                                <Rectangle Grid.Column="20" Width="{StaticResource Size.SeekBar.Block.Gap}" HorizontalAlignment="Right" Fill="{ThemeResource Brush.Border.Default}" />
                                <Rectangle Grid.Column="21" Width="{StaticResource Size.SeekBar.Block.Gap}" HorizontalAlignment="Right" Fill="{ThemeResource Brush.Border.Default}" />
                                <Rectangle Grid.Column="22" Width="{StaticResource Size.SeekBar.Block.Gap}" HorizontalAlignment="Right" Fill="{ThemeResource Brush.Border.Default}" />
                                <Rectangle Grid.Column="23" Width="{StaticResource Size.SeekBar.Block.Gap}" HorizontalAlignment="Right" Fill="{ThemeResource Brush.Border.Default}" />
                                <Rectangle Grid.Column="24" Width="{StaticResource Size.SeekBar.Block.Gap}" HorizontalAlignment="Right" Fill="{ThemeResource Brush.Border.Default}" />
                                <Rectangle Grid.Column="25" Width="{StaticResource Size.SeekBar.Block.Gap}" HorizontalAlignment="Right" Fill="{ThemeResource Brush.Border.Default}" />
                                <Rectangle Grid.Column="26" Width="{StaticResource Size.SeekBar.Block.Gap}" HorizontalAlignment="Right" Fill="{ThemeResource Brush.Border.Default}" />
                                <Rectangle Grid.Column="27" Width="{StaticResource Size.SeekBar.Block.Gap}" HorizontalAlignment="Right" Fill="{ThemeResource Brush.Border.Default}" />
                                <Rectangle Grid.Column="28" Width="{StaticResource Size.SeekBar.Block.Gap}" HorizontalAlignment="Right" Fill="{ThemeResource Brush.Border.Default}" />
                            </Grid>

                            <!-- Frame drawn last so it sits above the fills and the gaps. -->
                            <Border Grid.Row="1" Grid.ColumnSpan="3"
                                    Height="{StaticResource Size.SeekBar.Height}"
                                    BorderBrush="{ThemeResource Brush.Border.Default}"
                                    BorderThickness="{StaticResource BorderWidth.Standard.Thickness}"
                                    CornerRadius="{StaticResource Radius.Sharp}"
                                    IsHitTestVisible="False" />

                            <Thumb x:Name="HorizontalThumb"
                                   Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                                   Style="{StaticResource SliderThumbBaseStyle}"
                                   Width="{StaticResource Size.SeekBar.Thumb.Width}"
                                   Height="{StaticResource Size.SeekBar.Thumb.Height}"
                                   CornerRadius="{StaticResource Radius.Sharp}"
                                   AutomationProperties.AccessibilityView="Raw" />
                        </Grid>

                        <!-- Required part. This app never uses a vertical slider. -->
                        <Grid x:Name="VerticalTemplate" Visibility="Collapsed" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
