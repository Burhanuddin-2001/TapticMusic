<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="BaseButtonTemplateStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource Brush.Background.Surface}" />
        <Setter Property="BorderBrush" Value="{ThemeResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderWidth.Standard.Thickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sharp}" />
        <Setter Property="Foreground" Value="{ThemeResource Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="MinHeight" Value="{StaticResource Size.ControlHeight}" />
        <Setter Property="Padding" Value="{StaticResource Space.L.Thickness}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualMargin" Value="{StaticResource Focus.Visual.Margin}" />
        <!-- Step 16. A mouse click must not park the keyboard. Trap: see TRAPS.md T-10. -->
        <Setter Property="AllowFocusOnInteraction" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!--
                        Step 10c. Two layers: a shadow slab, then the control on top of it.

                        The Grid is now the template ROOT, so VisualStateManager.VisualStateGroups
                        MUST live on the Grid and not on Root. The VSM reads its groups off the root
                        element only — leaving them on Root compiles fine and silently kills every
                        state. That mistake cost Step 06 a round and Step 08 a gate.

                        No EasingFunction on any of these: a DoubleAnimation with none is linear
                        already, and linear is what a mechanical press wants. There is no LinearEase
                        type in WinUI, whatever the old note in Motion.xaml claimed.
                    -->
                    <Grid x:Name="Layout">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <!--
                                    Normal carries a storyboard of its own so RELEASE animates too.
                                    An empty Normal would only stop the Pressed storyboard, and the
                                    control would snap back instead of rising.
                                -->
                                <VisualState x:Name="Normal">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="0"
                                                         Duration="{StaticResource Motion.Duration.Fast}" />
                                        <DoubleAnimation Storyboard.TargetName="PressTransform"
                                                         Storyboard.TargetProperty="Y"
                                                         To="0"
                                                         Duration="{StaticResource Motion.Duration.Fast}" />
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource Brush.Surface.Hover}" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="0"
                                                         Duration="{StaticResource Motion.Duration.Fast}" />
                                        <DoubleAnimation Storyboard.TargetName="PressTransform"
                                                         Storyboard.TargetProperty="Y"
                                                         To="0"
                                                         Duration="{StaticResource Motion.Duration.Fast}" />
                                    </Storyboard>
                                </VisualState>

                                <!--
                                    Colour stays a Setter, geometry becomes a Storyboard. Never
                                    ColorAnimation a Brush.* value: those brushes are shared
                                    ResourceDictionary objects, so animating one here would mutate
                                    it for every control in the app.
                                -->
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource Brush.Accent.PrimaryPressed}" />
                                    </VisualState.Setters>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PressTransform"
                                                         Storyboard.TargetProperty="X"
                                                         To="{StaticResource Shadow.Offset}"
                                                         Duration="{StaticResource Motion.Duration.Fast}" />
                                        <DoubleAnimation Storyboard.TargetName="PressTransform"
                                                         Storyboard.TargetProperty="Y"
                                                         To="{StaticResource Shadow.Offset}"
                                                         Duration="{StaticResource Motion.Duration.Fast}" />
                                    </Storyboard>
                                </VisualState>

                                <!-- Fades the shadow with the control. Targeting Root would leave a
                                     solid slab under a ghosted button. -->
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Layout.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!-- Drawn first, so it sits behind. The negative right/bottom margin offsets
                             the slab without changing what the Grid measures. -->
                        <Border Background="{ThemeResource Brush.Shadow}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Margin="{StaticResource Shadow.Offset.Thickness}" />

                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <!-- UIElement.Translation is Composition-backed and throws when set from a
                                 VisualState Setter. RenderTransform is the approved fallback (D-2). -->
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="PressTransform" />
                            </Border.RenderTransform>

                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource BaseButtonTemplateStyle}" />

    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonTemplateStyle}">
        <Setter Property="Width" Value="{StaticResource Size.IconButton}" />
        <Setter Property="Height" Value="{StaticResource Size.IconButton}" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="PillAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonTemplateStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
        <Setter Property="Background" Value="{ThemeResource Brush.Accent.Primary}" />
        <Setter Property="Foreground" Value="{ThemeResource Brush.Text.OnAccent}" />
        <!-- MinHeight, never Height. A fixed Height plus Space.L padding leaves ~4px for the
             label, so the text renders clipped to nothing. design-plan section 7.1. -->
        <Setter Property="MinHeight" Value="{StaticResource Size.ControlHeight}" />
    </Style>

</ResourceDictionary>
