<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:MusicPlayer.Services">

    <Style x:Key="BaseTextBoxTemplateStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{ThemeResource Brush.Background.Surface}" />
        <Setter Property="BorderBrush" Value="{ThemeResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderWidth.Standard.Thickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sharp}" />
        <Setter Property="Foreground" Value="{ThemeResource Brush.Text.Primary}" />
        <Setter Property="PlaceholderForeground" Value="{ThemeResource Brush.Text.Secondary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Text}" />
        <Setter Property="services:TextScale.BaseSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Padding" Value="{StaticResource Space.M.Thickness}" />
        <Setter Property="FocusVisualMargin" Value="{StaticResource Focus.Visual.Margin}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource Brush.Surface.Hover}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource Brush.Focus}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid>
                            <ScrollViewer x:Name="ContentElement"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalContentAlignment="Center"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Disabled"
                                          IsTabStop="False"
                                          ZoomMode="Disabled" />
                            <TextBlock x:Name="PlaceholderTextContentPresenter"
                                       Text="{TemplateBinding PlaceholderText}"
                                       Foreground="{TemplateBinding PlaceholderForeground}"
                                       Padding="{TemplateBinding Padding}"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- No implicit TextBox style: all 3 sites use PillTextBoxStyle, so one was dead weight.
         Step 15. Add it back the day a square TextBox appears, or that box renders as WinUI. -->

    <Style x:Key="PillTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource BaseTextBoxTemplateStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Pill}" />
        <!-- MinHeight, never Height. A fixed Height clips the text at 150%+ OS text scaling.
             design-plan section 7.1. -->
        <Setter Property="MinHeight" Value="{StaticResource Size.ControlHeight}" />
    </Style>

</ResourceDictionary>
