<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MusicPlayer.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource Brush.Background.Canvas}"
          Padding="{StaticResource Space.Page.Padding}"
          RowSpacing="{StaticResource Space.L}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Style="{StaticResource Text.Heading1}"
                   Text="Settings"
                   HorizontalAlignment="Left" />

        <ScrollViewer Grid.Row="1" VerticalAlignment="Top">
            <StackPanel Spacing="{StaticResource Space.L}">

                <!--
                    The watched folders. This is the only way anything reaches the library, which is
                    why it exists in a step that otherwise adds no UI. Step 10 rebuilds this panel
                    to design-plan section 5.1.
                -->
                <ContentControl Style="{StaticResource PanelStyle}">
                    <StackPanel Spacing="{StaticResource Space.M}">
                        <TextBlock Style="{StaticResource Text.Heading2}" Text="Library" />

                        <TextBlock Style="{StaticResource Text.Caption}"
                                   x:Name="NoFoldersLine"
                                   x:Load="{x:Bind ViewModel.HasNoFolders, Mode=OneWay}"
                                   Text="No folders watched yet." />

                        <ItemsControl ItemsSource="{x:Bind ViewModel.Folders, Mode=OneWay}"
                                      AutomationProperties.Name="Watched folders">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Style="{StaticResource Text.Caption}"
                                               Text="{x:Bind}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.S}">
                            <Button Style="{StaticResource PillAccentButtonStyle}"
                                    Content="Add folder"
                                    Click="AddFolder_Click" />
                            <Button Content="Rescan" Click="Rescan_Click" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Text.Caption}"
                                   Text="{x:Bind ViewModel.Status, Mode=OneWay}" />
                    </StackPanel>
                </ContentControl>

                <ContentControl Style="{StaticResource PanelStyle}">
                    <StackPanel Spacing="{StaticResource Space.L}">
                        <Grid ColumnSpacing="{StaticResource Space.L}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="{StaticResource Space.XS}">
                                <TextBlock Style="{StaticResource Text.Title}" Text="Resume where I left off" />
                                <TextBlock Style="{StaticResource Text.Caption}" Text="Continue the last track when the app opens" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          Style="{StaticResource TwoStepSwitchStyle}"
                                          IsChecked="{x:Bind ViewModel.ResumeOnLaunch, Mode=TwoWay}"
                                          AutomationProperties.Name="Resume where I left off" />
                        </Grid>
                        <CheckBox Content="Scan folders on startup"
                                  IsChecked="{x:Bind ViewModel.ScanOnStartup, Mode=TwoWay}" />
                    </StackPanel>
                </ContentControl>

                <!--
                    Appearance. Step 13.

                    Two independent controls on purpose: the theme picks the neutrals, the swatch
                    picks the accent. Keeping them apart is what stops changing one from resetting
                    the other.

                    Both bind SelectedIndex, so both view model properties are int. The radio order
                    here IS the enum order in Services/ThemeService.cs — AppTheme and AccentSwatch
                    persist as ints, so reordering either list silently changes every saved value.
                -->
                <ContentControl Style="{StaticResource PanelStyle}">
                    <StackPanel Spacing="{StaticResource Space.L}">
                        <TextBlock Style="{StaticResource Text.Heading2}" Text="Appearance" />

                        <StackPanel Spacing="{StaticResource Space.XS}">
                            <TextBlock Style="{StaticResource Text.Title}" Text="Theme" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="System follows your Windows setting" />
                        </StackPanel>
                        <RadioButtons SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}"
                                      AutomationProperties.Name="Theme">
                            <x:String>System</x:String>
                            <x:String>Light</x:String>
                            <x:String>Dark</x:String>
                        </RadioButtons>

                        <StackPanel Spacing="{StaticResource Space.XS}">
                            <TextBlock Style="{StaticResource Text.Title}" Text="Accent" />
                            <TextBlock Style="{StaticResource Text.Caption}" Text="Used for the playing track, selection and primary buttons" />
                        </StackPanel>
                        <RadioButtons SelectedIndex="{x:Bind ViewModel.AccentIndex, Mode=TwoWay}"
                                      AutomationProperties.Name="Accent colour">
                            <x:String>Bauhaus Grid — ultramarine</x:String>
                            <x:String>Braun Functionalist — amber</x:String>
                            <x:String>Revox Tape Reel — vermillion</x:String>
                            <x:String>Fanzine Punk — tangerine</x:String>
                            <x:String>Digital Matrix — violet</x:String>
                        </RadioButtons>
                    </StackPanel>
                </ContentControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
