<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MusicPlayer.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MusicPlayer.Controls"
    xmlns:vm="using:MusicPlayer.ViewModels">

    <!--
        THE DEAL, Step 14. This page used to be a stat strip over "recently added" and "recently
        played"; both told the user what they already knew. It now answers the one question a landing
        page is actually asked - what do I play now - two ways: the accent button for "anything", and
        three random picks for "surprise me". The stats moved to the bottom, where a number you read
        once belongs.
    -->
    <Grid Background="{ThemeResource Brush.Background.Canvas}"
          Padding="{StaticResource Space.Page.Padding}"
          RowSpacing="{StaticResource Space.L}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Style="{StaticResource Text.Heading1}"
                   Text="Dashboard"
                   HorizontalAlignment="Left" />

        <ScrollViewer Grid.Row="1"
                      x:Name="DashboardContent"
                      x:Load="{x:Bind ViewModel.HasTracks, Mode=OneWay}">
            <StackPanel Spacing="{StaticResource Space.L}">

                <!--
                    Two equal columns, both stretched. Neither button grows TALLER than
                    Size.ControlHeight and they must not: Radius.Pill is 24, exactly half of 48, and
                    that is the only ratio at which the pill's sides render flat instead of bowing
                    into an ellipse. Width is free, height is not. See the stadium rule in the design system notes.
                -->
                <Grid ColumnSpacing="{StaticResource Space.S}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource PillAccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Content="Play something"
                            Click="PlaySomething_Click" />

                    <Button Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Content="Reroll"
                            Click="Reroll_Click" />
                </Grid>

                <StackPanel Spacing="{StaticResource Space.XS}">
                    <TextBlock Style="{StaticResource Text.Heading2}" Text="Dealt to you" />
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Text="An album, an artist and a playlist. A new three every launch." />
                </StackPanel>

                <!--
                    Inner scrolling off, the same as the lists this page used to hold: it sits inside
                    the page ScrollViewer and two nested scrollers fight. Three items, so measuring
                    them all costs nothing.

                    ItemsWrapGrid and not a three-column Grid, and that is not cosmetic. Three tiles
                    need 684 and the frame is about 468 at the minimum window size, so the row has to
                    be able to reflow to two-plus-one. Same container style as the Playlists index.
                -->
                <ListView x:Name="DealList"
                          ItemsSource="{x:Bind ViewModel.Deal, Mode=OneWay}"
                          ItemContainerStyle="{StaticResource TileItemStyle}"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="Deal_ItemClick"
                          AutomationProperties.Name="Dealt to you">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DealCard">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Height only. The width comes from the container, so the art is
                                     the tile's width less its 2px border on each side. -->
                                <controls:ArtMosaic Grid.Row="0"
                                                    Height="{StaticResource Size.Tile}"
                                                    Cover0="{x:Bind Cover0}"
                                                    Cover1="{x:Bind Cover1}"
                                                    Cover2="{x:Bind Cover2}"
                                                    Cover3="{x:Bind Cover3}" />

                                <StackPanel Grid.Row="1"
                                            Margin="{StaticResource Space.M.Thickness}"
                                            Spacing="{StaticResource Space.XS}">
                                    <TextBlock Style="{StaticResource Text.Heading2}"
                                               Text="{x:Bind Title}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind Title}" />
                                    <TextBlock Style="{StaticResource Text.Caption}"
                                               Text="{x:Bind Subtitle}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- The 4-up stat strip, kept but demoted. design-plan section 5.1. -->
                <ContentControl Style="{StaticResource PanelStyle}">
                    <Grid ColumnSpacing="{StaticResource Space.L}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Text.Display}"
                                       Typography.NumeralAlignment="Tabular"
                                       Text="{x:Bind ViewModel.TrackCount, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource Text.Micro}" Text="TRACKS" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource Text.Display}"
                                       Typography.NumeralAlignment="Tabular"
                                       Text="{x:Bind ViewModel.AlbumCount, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource Text.Micro}" Text="ALBUMS" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Text.Display}"
                                       Typography.NumeralAlignment="Tabular"
                                       Text="{x:Bind ViewModel.ArtistCount, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource Text.Micro}" Text="ARTISTS" />
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Style="{StaticResource Text.Display}"
                                       Typography.NumeralAlignment="Tabular"
                                       Text="{x:Bind ViewModel.TotalHours, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource Text.Micro}" Text="HOURS" />
                        </StackPanel>
                    </Grid>
                </ContentControl>

            </StackPanel>
        </ScrollViewer>

        <controls:EmptyStateView Grid.Row="1"
                                 x:Name="EmptyDashboardState"
                                 x:Load="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                                 Glyph="&#xE93C;"
                                 Title="No music yet"
                                 Message="Add a folder to build your library." />
    </Grid>
</Page>
