<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MusicPlayer.Views.PlaylistsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:MusicPlayer.Converters"
    xmlns:controls="using:MusicPlayer.Controls"
    xmlns:vm="using:MusicPlayer.ViewModels">

    <Page.Resources>
        <conv:DurationToStringConverter x:Key="DurationToString" />
    </Page.Resources>

    <!--
        Step 11. One page, two views, swapped by x:Load on ViewModel.ShowIndexView / ShowDetail:
        the index of playlists, and one open playlist that reads as its own page.

        Not two Page types. The sidebar rail owns navigation and points at exactly one
        PlaylistsPage, so a second one would mean teaching MainWindow about a page the rail never
        names. Leaving and returning lands on the index, because page ViewModels are new-ed per
        visit and never cached (A4).
    -->
    <Grid Background="{ThemeResource Brush.Background.Canvas}"
          Padding="{StaticResource Space.Page.Padding}">

        <!-- ============================ LEVEL 1 · THE INDEX ============================ -->
        <Grid x:Name="IndexView"
              x:Load="{x:Bind ViewModel.ShowIndexView, Mode=OneWay}"
              RowSpacing="{StaticResource Space.M}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="{StaticResource Size.PageHeader.MinHeight}" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="{StaticResource Space.S}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Text.Heading1, the same as every other tab's title. v1.1. Title, pill and button all
                     centre in the row. A top-aligned title left the pill sitting below it. Tight,
                     the slimmer button padding and the overhang are explained at
                     Size.PageHeader.MinHeight. -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="{StaticResource Space.M}"
                            HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource Text.Heading1}" Text="Playlists" TextLineBounds="Tight" VerticalAlignment="Center" />
                    <controls:BadgePill VerticalAlignment="Center"
                                        Margin="{StaticResource Space.PageHeader.Overhang}"
                                        Text="{x:Bind ViewModel.PlaylistCount, Mode=OneWay}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource PillAccentButtonStyle}"
                        Padding="{StaticResource Space.PageHeader.Button.Padding}"
                        Margin="{StaticResource Space.PageHeader.Overhang}"
                        Content="New playlist"
                        Click="NewPlaylist_Click" />
            </Grid>

            <!--
                SelectionMode=None with click-to-open, the same as the Dashboard deal. That is not
                only about behaviour: a tile that never reaches the Selected state never hits O-7, so
                its labels can take the ordinary Text.* styles straight from the DataTemplate and
                nothing has to become a named part inside TileItemStyle.

                ItemsWrapGrid replaces the default ItemsStackPanel, and ItemWidth and ItemHeight are
                left unset on purpose so the first realised tile's desired size becomes every cell.
                Still a ListView and not a GridView: a GridViewItem would ignore every container
                style in Styles/ListView.xaml and need a fifteenth style file to get them back.
            -->
            <ListView Grid.Row="1"
                      x:Name="PlaylistList"
                      x:Load="{x:Bind ViewModel.ShowIndex, Mode=OneWay}"
                      ItemsSource="{x:Bind ViewModel.Playlists, Mode=OneWay}"
                      ItemContainerStyle="{StaticResource TileItemStyle}"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemClick="PlaylistList_ItemClick"
                      AutomationProperties.Name="Playlists">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlaylistTile">
                        <!--
                            The flyout lives on the DataTemplate root, not on a Style setter. A
                            ContextFlyout set from a Style is one shared object across every tile and
                            they fight over it; a DataTemplate is instantiated per item, so each tile
                            gets its own and DataContext is already the right PlaylistTile.
                        -->
                        <Grid>
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Play" Click="PlaylistPlay_Click" />
                                    <MenuFlyoutItem Text="Rename..." Click="PlaylistRename_Click" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Delete" Click="PlaylistDelete_Click" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Height only. The width comes from the container, so the art is the
                                 tile's width less its 2px border on each side. -->
                            <controls:ArtMosaic Grid.Row="0"
                                                Height="{StaticResource Size.Tile}"
                                                Cover0="{x:Bind Cover0}"
                                                Cover1="{x:Bind Cover1}"
                                                Cover2="{x:Bind Cover2}"
                                                Cover3="{x:Bind Cover3}" />

                            <StackPanel Grid.Row="1"
                                        Margin="{StaticResource Space.M.Thickness}"
                                        Spacing="{StaticResource Space.XS}">
                                <TextBlock Style="{StaticResource Text.Heading2}"
                                           Text="{x:Bind Name}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTipService.ToolTip="{x:Bind Name}" />
                                <TextBlock Style="{StaticResource Text.Caption}"
                                           Typography.NumeralAlignment="Tabular"
                                           TextTrimming="CharacterEllipsis"><Run Text="{x:Bind TrackCountLabel}" /><Run Text=" · " /><Run Text="{x:Bind TotalMs, Converter={StaticResource DurationToString}}" /></TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <controls:EmptyStateView Grid.Row="1"
                                     x:Name="NoPlaylistsState"
                                     x:Load="{x:Bind ViewModel.ShowNoPlaylists, Mode=OneWay}"
                                     Glyph="&#xE8FD;"
                                     Title="No playlists yet"
                                     Message="Group the tracks you keep coming back to. Start with one." />
        </Grid>

        <!-- ======================== LEVEL 2 · ONE OPEN PLAYLIST ======================== -->
        <Grid x:Name="DetailView"
              x:Load="{x:Bind ViewModel.ShowDetail, Mode=OneWay}"
              RowSpacing="{StaticResource Space.M}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Plain Button: the implicit style, the same one the Library's Shuffle already uses.

                 Step 13: the chevron used to be a PUA codepoint inside the Content string, leaning
                 on DirectWrite to fall back to Segoe Fluent Icons for it. Bahnschrift broke that
                 fallback and it rendered as a tofu box. A real FontIcon is what the other 22 icon
                 sites already do, and it cannot depend on the text font at all. -->
            <Button Grid.Row="0"
                    HorizontalAlignment="Left"
                    Click="Back_Click"
                    AutomationProperties.Name="Back to playlists">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space.S}">
                    <FontIcon Glyph="&#xE72B;" FontSize="{StaticResource Size.Glyph.Small}" VerticalAlignment="Center" />
                    <TextBlock Text="Playlists" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Grid Grid.Row="1" ColumnSpacing="{StaticResource Space.S}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="{StaticResource Space.M}"
                            HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource Text.Heading1}"
                               Text="{x:Bind ViewModel.Selected.Name, Mode=OneWay}"
                               TextLineBounds="Tight"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind ViewModel.Selected.Name, Mode=OneWay}" />
                    <controls:BadgePill VerticalAlignment="Center"
                                        Text="{x:Bind ViewModel.Selected.TrackCountLabel, Mode=OneWay}" />
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource PillAccentButtonStyle}"
                        Content="Play all"
                        IsEnabled="{x:Bind ViewModel.DetailHasTracks, Mode=OneWay}"
                        Click="PlayAll_Click" />

                <Button Grid.Column="2"
                        Content="Shuffle"
                        IsEnabled="{x:Bind ViewModel.DetailHasTracks, Mode=OneWay}"
                        Click="Shuffle_Click" />
            </Grid>

            <!--
                TrackRowItemStyle unchanged, so a playlist reads exactly like the Library.
                No column header row on purpose: the order here is the user's to drag, so sortable
                headers would contradict it, and a header would be a THIRD copy of the
                44 / 2.75* / 1* / 1* / 60 widths that A12 exists to keep down to two.
            -->
            <ListView Grid.Row="2"
                      x:Name="TrackList"
                      x:Load="{x:Bind ViewModel.DetailHasTracks, Mode=OneWay}"
                      ItemsSource="{x:Bind ViewModel.Tracks, Mode=OneWay}"
                      ItemContainerStyle="{StaticResource TrackRowItemStyle}"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemClick="Tracks_ItemClick"
                      CanReorderItems="True"
                      AllowDrop="True"
                      CanDragItems="True"
                      DragItemsCompleted="TrackList_DragItemsCompleted"
                      RightTapped="TrackList_RightTapped"
                      AutomationProperties.Name="Playlist tracks">
                <ListView.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Remove from playlist" Click="RemoveTrack_Click" />
                    </MenuFlyout>
                </ListView.ContextFlyout>
            </ListView>

            <controls:EmptyStateView Grid.Row="2"
                                     x:Name="EmptyPlaylistState"
                                     x:Load="{x:Bind ViewModel.DetailIsEmpty, Mode=OneWay}"
                                     Glyph="&#xE710;"
                                     Title="Nothing in here yet"
                                     Message="Go to your Library, right-click any track, and choose Add to playlist." />
        </Grid>
    </Grid>
</Page>
